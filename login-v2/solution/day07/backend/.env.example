# 本机配置模板：cp .env.example .env 后按需修改，改完不用告诉任何人。
# .env 只留在你本机、永不进仓库（见 .gitignore）；这份示例才是仓库里的「配置清单」。

# 服务监听端口
PORT=3000

# SQLite 数据库文件路径（相对启动目录；*.db 已被 .gitignore 排除）
DB_PATH=login-v2.db

# bcrypt 轮数：生产 10+；本地想跑快点可以调小
BCRYPT_ROUNDS=10

# 不设置 → 用本地 SQLite（DB_PATH）；设置后账号仓储切到 PostgreSQL（Day 07）
# DATABASE_URL=postgres://user:password@localhost:5432/login_v2
